{
  "cli": {
    "version": ">= 5.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "uat": {
      "distribution": "store",
      "channel": "uat",
      "env": {
        "EXPO_PUBLIC_ENV": "uat"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
      }
    },
    "uat": {
      "ios": {
        "ascAppId": "6758571311"
      }
    }
  }
}
