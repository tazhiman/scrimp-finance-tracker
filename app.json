{
  "expo": {
    "name": "Scrimp App",
    "slug": "scrimp-app",
    "version": "1.1.6",
    "sdkVersion": "55.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scrimp.app",
      "buildNumber": "9",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.scrimp.app"
        ]
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Scrimp App does not use your location. This permission is required by a third-party library but is never accessed.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Scrimp App does not use your location. This permission is required by a third-party library but is never accessed."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.scrimp.app",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "financetracker",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#D0EFB1",
          "sounds": []
        }
      ],
      "./plugins/withAppIntents",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5d8353be-4e02-4bd5-a796-648c22a2f592"
      },
      "scrimpWalletShortcutUrl": "https://www.icloud.com/shortcuts/cc2f5da90ed844aa84fa25fd98ac27be"
    },
    "runtimeVersion": "1.1.6"
  }
}
